# Copy to backend/.env and adjust. backend/.env is git-ignored.

PROJECT_NAME=TestPilot AI
VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# Comma-separated list of allowed browser origins (the Vite dev server).
# 5173 is Vite's default; 5174 lets a second project run alongside this one.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
